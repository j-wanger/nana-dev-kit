{
  "modules": [
    {
      "name": "core",
      "depends_on": [],
      "flags": { "enable": "--all", "disable": "--core-only" },
      "skills": ["spec", "nana", "memory-consolidate", "nana-init"],
      "rules": ["nana-soul.md", "file-lifecycle.md"],
      "rules_conditional": ["nana-personal.md"],
      "markers": [],
      "mcp": {
        "name": "memory",
        "module": "memory_server",
        "cwd": "~/.claude",
        "env": { "PYTHONPATH": "~/.claude" }
      }
    },
    {
      "name": "python",
      "depends_on": ["core"],
      "flags": { "disable": "--no-python" },
      "skills": ["py-init", "py-lint", "py-review", "py-test"],
      "rules": [],
      "markers": []
    },
    {
      "name": "typescript",
      "depends_on": ["core"],
      "flags": { "disable": "--no-typescript" },
      "skills": ["ts-init"],
      "rules": [],
      "markers": []
    },
    {
      "name": "dev-wiki",
      "depends_on": ["core"],
      "flags": {},
      "skills": ["dev-wiki", "dev-check", "dev-debrief", "dev-init", "dev-plan", "dev-scan"],
      "rules": [],
      "markers": ["~/.claude/enforce", "~/.claude/enforce-memory"]
    },
    {
      "name": "knowledge-wiki",
      "depends_on": ["core"],
      "flags": {},
      "skills": ["knowledge-wiki", "wiki-absorb", "wiki-add", "wiki-bootstrap", "wiki-health", "wiki-index", "wiki-init", "wiki-query", "wiki-reorg", "wiki-registry"],
      "rules": [],
      "markers": []
    }
  ],
  "hooks": [
    { "event": "SessionStart", "matcher": "", "script": "session-start.sh", "scope": "project" },
    { "event": "PreToolUse", "matcher": "Write|Edit|MultiEdit", "script": "enforce-spec.sh", "scope": "project" },
    { "event": "PreToolUse", "matcher": "Write|Edit|MultiEdit", "script": "enforce-memory.sh", "scope": "project" },
    { "event": "PreToolUse", "matcher": "Write|Edit|MultiEdit", "script": "enforce-assumption-gate.sh", "scope": "project" },
    { "event": "PreToolUse", "matcher": "Write|Edit|MultiEdit", "script": "dev-wiki-scope-check.sh", "scope": "project" },
    { "event": "PreToolUse", "matcher": "Write|Edit|MultiEdit", "script": "scan-secrets.sh", "scope": "project" },
    { "event": "PreToolUse", "matcher": "Bash", "script": "block-dangerous-bash.sh", "scope": "project" },
    { "event": "PostToolUse", "matcher": "Write|Edit|MultiEdit", "script": "auto-ruff-format.sh", "scope": "project" },
    { "event": "PostToolUse", "matcher": "Write|Edit|MultiEdit", "script": "audit-log.sh", "scope": "project" },
    { "event": "PostToolUse", "matcher": "Write|Edit|MultiEdit", "script": "stale-queue.sh", "scope": "project" },
    { "event": "PostToolUse", "matcher": "Bash", "script": "post-commit.sh", "scope": "project" },
    { "event": "Stop", "matcher": "", "script": "enforce-loop.sh", "scope": "project" },
    { "event": "Stop", "matcher": "", "script": "session-stop.sh", "scope": "project" },
    { "event": "Stop", "matcher": "", "script": "check-tests-were-run.sh", "scope": "project" },
    { "event": "Stop", "matcher": "", "script": "py-review-stop.sh", "scope": "project" },
    { "event": "PreCompact", "matcher": "", "script": "pre-compact.sh", "scope": "project" },
    { "event": "PostCompact", "matcher": "", "script": "post-compact.sh", "scope": "project" },
    { "event": "UserPromptSubmit", "matcher": "", "script": "context-size-check.sh", "scope": "global" }
  ],
  "ghost_cleanup": ["dev-wiki-post-commit"],
  "cut_hooks": ["detect-loop"],
  "hook_dirs": {
    "session-start.sh": ["session-start.d"]
  }
}
