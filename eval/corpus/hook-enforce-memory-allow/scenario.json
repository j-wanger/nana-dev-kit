{
  "name": "enforce-memory allows write when a real memory_search is in the transcript",
  "category": "hook",
  "hook": "enforce-memory.sh",
  "scoring": "binary",
  "setup": {
    "cwd_files": {
      ".dev-wiki/.gitkeep": "marker",
      ".transcript.jsonl": "{\"type\":\"assistant\",\"timestamp\":\"2026-06-20T12:00:00Z\",\"message\":{\"content\":[{\"type\":\"tool_use\",\"name\":\"mcp__memory__memory_search\"}]}}"
    },
    "home_files": {
      ".claude/enforce-memory": "marker",
