{
  "name": "session-start suppresses recovery when debrief commit exists",
  "category": "hook",
  "hook": "session-start.sh",
  "scoring": "binary",
  "setup": {
    "cwd_files": {
      ".dev-wiki/_CURRENT_STATE.md": "current-state.md"
    },
    "touch_old": [".dev-wiki/_CURRENT_STATE.md"],
    "init_git": "Debrief Phase 25: completed"
  },
  "input": "",
  "expected": {
    "exit_code": 0,
    "stdout_not_contains": ["\\[recovery\\]"]
  }
}
