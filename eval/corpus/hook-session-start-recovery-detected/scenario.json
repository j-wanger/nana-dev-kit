{
  "name": "session-start detects commits since last state update with no debrief",
  "category": "hook",
  "hook": "session-start.sh",
  "scoring": "binary",
  "setup": {
    "cwd_files": {
      ".dev-wiki/_CURRENT_STATE.md": "current-state.md"
    },
    "touch_old": [".dev-wiki/_CURRENT_STATE.md"],
    "init_git": "Phase 26 implementation commit"
  },
  "input": "",
  "expected": {
    "exit_code": 0,
    "stdout_contains": ["\\[nana:recovery\\]"]
  }
}
