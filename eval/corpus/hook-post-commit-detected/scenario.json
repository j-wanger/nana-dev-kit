{
  "name": "post-commit detects successful git commit and emits trigger",
  "category": "hook",
  "hook": "post-commit.sh",
  "scoring": "binary",
  "setup": {
    "cwd_files": {
      ".dev-wiki/.gitkeep": "enforce-marker"
    },
    "home_files": {
      ".claude/enforce": "enforce-marker"
    },
    "init_git": true
  },
  "input": "{\"tool_name\": \"Bash\", \"tool_input\": {\"command\": \"git commit -m \\\"add feature\\\"\"}, \"stdout\": \"\", \"stderr\": \"\", \"exit_code\": 0}",
  "expected": {
    "exit_code": 0,
    "stdout_contains": [
      "dev-wiki:post-commit"
    ]
  }
}
